# REST API ML Security Research - Environment Configuration
# System Ports
GATEWAY_PORT=8080
DEMO_API_PORT=5001
ML_PORT=8000
FRONTEND_PORT=5173
DASHBOARD_PORT=5174

# Database
MONGO_URI=mongodb://localhost:27017/api_security_research

# OWASP ZAP
ZAP_PORT=8090
ZAP_HOST=127.0.0.1
